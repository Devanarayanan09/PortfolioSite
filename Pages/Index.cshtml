@page
@model IndexModel
@{
    ViewData["Title"] = "Digital Portfolio";
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7 reveal">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-4 rounded-pill bg-white shadow-sm border border-light">
                    <span class="d-block w-2 h-2 rounded-circle bg-success"></span>
                    <span class="small fw-bold text-muted">Senior Backend Developer</span>
                </div>
                <h1 class="hero-title">
                    I build the <br /> 
                    <span style="color: var(--secondary)">Engines</span> of the <br />
                    modern web.
                </h1>
                <p class="hero-subtitle">
                    Hi, I'm Deva. I specialize in architecting high-performance backend systems that power seamless digital experiences.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-page="/Projects" class="btn-main">View My Work</a>
                    <a asp-page="/Contact" class="btn-alt">Let's Talk</a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block reveal" style="transition-delay: 0.2s">
                <div class="position-relative">
                    <div class="position-absolute top-50 start-50 translate-middle w-100 h-100 rounded-circle" style="background: var(--primary-soft); filter: blur(80px); z-index: -1;"></div>
                    <div class="card-neo p-5 text-center">
                        <div class="mb-4 d-inline-block p-4 rounded-4" style="background: var(--bg-secondary); color: var(--primary);">
                            <i class="fas fa-layer-group fa-4x"></i>
                        </div>
                        <h3 class="mb-3">Full Stack Mindset</h3>
                        <p class="text-muted small">Though I'm a backend specialist, I understand the whole lifecycle of a product.</p>
                        <div class="d-flex justify-content-center gap-2 mt-4">
                            <span class="tag-pill">.NET 8</span>
                            <span class="tag-pill">SQL</span>
                            <span class="tag-pill">Web API</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-white">
    <div class="container">
        <div class="row mb-5 reveal">
            <div class="col-lg-6">
                <h2 class="display-4 mb-3">Work <span class="text-primary">Experience</span></h2>
                <p class="text-muted lead">Collaborating with industry leaders to build robust software.</p>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var exp in Model.Experiences.OrderByDescending(e => e.StartDate))
            {
                <div class="col-lg-6 reveal">
                    <a asp-page="/Projects" asp-route-experienceId="@exp.Id" class="text-decoration-none d-block h-100">
                        <div class="card-neo h-100">
                            <div class="d-flex justify-content-between align-items-start mb-4">
                                <div>
                                    <h3 class="h4 mb-1">@exp.Position</h3>
                                    <div class="fw-bold text-primary">@exp.Company</div>
                                </div>
                                <div class="small fw-bold text-muted px-3 py-1 rounded-pill bg-light">
                                    @exp.StartDate.Year — @(exp.IsCurrent ? "Now" : exp.EndDate?.Year.ToString())
                                </div>
                            </div>
                            <p class="text-muted mb-4">@exp.Description</p>
                            <div class="d-flex flex-wrap gap-2 mb-4">
                                @foreach (var tech in exp.Technologies.Split(','))
                                {
                                    <span class="tag-pill m-0">@tech.Trim()</span>
                                }
                            </div>
                            <div class="mt-auto pt-3 border-top border-light d-flex align-items-center text-primary fw-bold small">
                                <span>View Projects</span>
                                <i class="fas fa-arrow-right ms-2 transition-transform"></i>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="card-neo bg-primary text-white text-center p-5 reveal">
            <h2 class="display-5 text-white mb-4">Ready to start a <br /> project together?</h2>
            <p class="lead mb-5 opacity-75">I'm currently available for senior-level backend consulting or full-time roles.</p>
            <a asp-page="/Contact" class="btn btn-light rounded-pill px-5 py-3 fw-bold text-primary">Get in Touch</a>
        </div>
    </div>
</section>

<style>
    .w-2 { width: 0.5rem; }
    .h-2 { height: 0.5rem; }
</style>