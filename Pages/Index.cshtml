@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <h1 class="display-4 mb-4">Hi, I'm Deva</h1>
                <p class="lead mb-4">.NET Developer with 3+ years of experience building scalable web applications</p>
                <a href="#experience" class="btn btn-light btn-lg">View My Experience</a>
            </div>
        </div>
    </div>
</section>

<section id="experience" class="py-5">
    <div class="container">
        <h2 class="text-center mb-5">Professional Experience</h2>

        <div class="row">
            <div class="col-lg-8 mx-auto">
                @foreach (var experience in Model.Experiences)
                {
                    <div class="experience-card card mb-4">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h4 class="card-title">@experience.Position</h4>
                                    <h5 class="text-primary">@experience.Company</h5>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-primary">
                                        @experience.StartDate.ToString("MMM yyyy") -
                                        @(experience.IsCurrent ? "Present" : experience.EndDate?.ToString("MMM yyyy"))
                                    </span>
                                </div>
                            </div>

                            <p class="card-text mt-3">@experience.Description</p>

                            <div class="tech-stack mb-3">
                                <strong>Technologies:</strong>
                                @foreach (var tech in experience.Technologies.Split(','))
                                {
                                    <span class="tech-badge">@tech.Trim()</span>
                                }
                            </div>

                            @if (experience.Projects.Any())
                            {
                                <div class="projects-preview">
                                    <h6 class="mb-2">Key Projects:</h6>
                                    <div class="row">
                                        @foreach (var project in experience.Projects.Take(2))
                                        {
                                            <div class="col-md-6 mb-2">
                                                <div class="card project-preview-card">
                                                    <div class="card-body p-3">
                                                        <h6 class="card-title mb-1">@project.Title</h6>
                                                        <p class="card-text small mb-1">@Html.Raw(project.Description)</p>
                                                        <div class="d-flex flex-wrap">
                                                            @foreach (var tech in project.Technologies.Split(',').Take(2))
                                                            {
                                                                <span class="tech-badge small">@tech.Trim()</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <a asp-page="/Projects" asp-route-experienceId="@experience.Id"
                                       class="btn btn-outline-primary btn-sm mt-2">
                                        View All Projects (@experience.Projects.Count)
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<section class="bg-light py-5">
    <div class="container text-center">
        <h2 class="mb-4">View My Complete Portfolio</h2>
        <p class="lead mb-4">Explore all my projects and detailed work experience</p>
        <a asp-page="/Projects" class="btn btn-primary btn-lg">View Full Portfolio</a>
    </div>
</section>

<style>
    .experience-card {
        transition: transform 0.3s ease;
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

        .experience-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        }

    .project-preview-card {
        border: 1px solid #e9ecef;
        border-radius: 10px;
        transition: all 0.2s ease;
    }

        .project-preview-card:hover {
            border-color: var(--secondary-color);
            background-color: #f8f9fa;
        }

    .tech-badge.small {
        font-size: 0.7rem;
        padding: 2px 6px;
        margin: 1px;
    }
</style>