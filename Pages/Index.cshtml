@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <div class="badge bg-primary bg-opacity-10 text-cyan mb-3 px-3 py-2 rounded-pill border border-cyan border-opacity-25" style="color: var(--accent-cyan);">
                    Available for new opportunities
                </div>
                <h1 class="display-1 fw-bold mb-4">
                    Building <span class="text-gradient">Scalable</span> <br />
                    Backend Systems
                </h1>
                <p class="lead text-secondary mb-5 fs-4" style="max-width: 600px;">
                    I'm Deva, a Senior Backend Developer specializing in architecting high-performance APIs and robust database solutions with .NET and PostgreSQL.
                </p>
                <div class="d-flex gap-3">
                    <a href="#experience" class="btn btn-premium">Explore Experience</a>
                    <a asp-page="/Projects" class="btn btn-premium-outline">View My Work</a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block position-relative">
                <div class="position-absolute top-50 start-50 translate-middle" style="width: 500px; height: 500px; background: var(--accent-gradient); filter: blur(120px); opacity: 0.3; border-radius: 50%; animation: pulse-glow 4s infinite alternate;"></div>
                <div class="glass-card p-5 text-center shadow-2xl" style="border: 1px solid rgba(255,255,255,0.2);">
                    <i class="fas fa-rocket fa-5x text-gradient mb-4"></i>
                    <h3 class="h4 fw-bold">Ready for Launch</h3>
                    <p class="text-secondary small">Architecting high-performance systems for the modern web.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="experience" class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-4 fw-bold mb-3">Professional <span class="text-gradient">Journey</span></h2>
            <p class="text-secondary lead">My career progression and notable achievements</p>
        </div>

        <div class="row">
            <div class="col-lg-10 mx-auto">
                @foreach (var experience in Model.Experiences.OrderByDescending(e => e.StartDate))
                {
                    <div class="glass-card mb-5 exp-card p-4 p-md-5">
                        <div class="row">
                            <div class="col-md-3 mb-3 mb-md-0">
                                <span class="exp-date">
                                    @experience.StartDate.ToString("MMM yyyy") — 
                                    @(experience.IsCurrent ? "PRESENT" : experience.EndDate?.ToString("MMM yyyy"))
                                </span>
                                <h5 class="exp-company mt-2">@experience.Company</h5>
                            </div>
                            <div class="col-md-9">
                                <h3 class="h4 fw-bold mb-3">@experience.Position</h3>
                                <p class="text-secondary mb-4 fs-5">@experience.Description</p>
                                
                                <div class="tech-stack mb-4">
                                    @foreach (var tech in experience.Technologies.Split(','))
                                    {
                                        <span class="tech-pill">@tech.Trim()</span>
                                    }
                                </div>

                                @if (experience.Projects.Any())
                                {
                                    <div class="projects-preview mt-4">
                                        <h6 class="text-secondary mb-3 text-uppercase small ls-wide">Featured Projects in this role:</h6>
                                        <div class="row g-3">
                                            @foreach (var project in experience.Projects.Take(2))
                                            {
                                                <div class="col-md-6">
                                                    <a asp-page="/Projects" asp-fragment="project-@project.Id" class="text-decoration-none">
                                                        <div class="glass-card p-3 h-100 border-opacity-10 bg-transparent">
                                                            <h6 class="text-primary mb-1">@project.Title</h6>
                                                            <p class="text-secondary small mb-0">@Html.Raw(project.Description.Substring(0, Math.Min(60, project.Description.Length)))...</p>
                                                        </div>
                                                    </a>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<section class="py-5 text-center">
    <div class="container">
        <div class="glass-card p-5">
            <h2 class="display-5 fw-bold mb-4">Let's build something <span class="text-gradient">remarkable</span></h2>
            <p class="lead text-secondary mb-5 mx-auto" style="max-width: 700px;">
                I am always interested in discussing complex backend challenges, system design, or innovative software engineering projects.
            </p>
            <a asp-page="/Contact" class="btn btn-premium btn-lg px-5">Get In Touch</a>
        </div>
    </div>
</section>

<style>
    .ls-wide { letter-spacing: 0.1em; }
</style>