@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero-section py-5 px-3 d-flex align-items-center" style="min-height: 60vh;">
    <div class="container animate-float">
        <div class="row">
            <div class="col-lg-10 mx-auto text-center">
                <h1 class="display-2 mb-4 fw-bolder tracking-tight">Hi, I'm <span class="text-primary">Deva</span></h1>
                <p class="lead mb-5 text-light fs-4" style="max-width: 800px; margin: 0 auto;">
                    .NET Developer with 3+ years of experience building scalable web applications.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a href="#experience" class="btn btn-primary btn-lg">View Experience</a>
                    <a asp-page="/Projects" class="btn btn-outline-primary btn-lg">View Projects</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="experience" class="py-5">
    <div class="container">
        <h2 class="text-center mb-5">Professional Experience</h2>

        <div class="row">
            <div class="col-lg-10 mx-auto">
                @foreach (var experience in Model.Experiences)
                {
                    <div class="glass-card mb-4 mb-lg-5">
                        <div class="card-body bg-transparent p-0">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h4 class="card-title">@experience.Position</h4>
                                    <h5 class="text-primary">@experience.Company</h5>
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-primary">
                                        @experience.StartDate.ToString("MMM yyyy") -
                                        @(experience.IsCurrent ? "Present" : experience.EndDate?.ToString("MMM yyyy"))
                                    </span>
                                </div>
                            </div>

                            <p class="card-text mt-3">@experience.Description</p>

                            <div class="tech-stack mb-3">
                                <strong>Technologies:</strong>
                                @foreach (var tech in experience.Technologies.Split(','))
                                {
                                    <span class="tech-badge">@tech.Trim()</span>
                                }
                            </div>

                            @if (experience.Projects.Any())
                            {
                                <div class="projects-preview">
                                    <h6 class="mb-2">Key Projects:</h6>
                                    <div class="row">
                                        @foreach (var project in experience.Projects.Take(2))
                                        {
                                            <div class="col-md-6 mb-2">
                                                <div class="glass-panel text-start h-100">
                                                    <div class="card-body p-3">
                                                        <h6 class="card-title mb-1">@project.Title</h6>
                                                        <p class="card-text small mb-1">@Html.Raw(project.Description)</p>
                                                        <div class="d-flex flex-wrap">
                                                            @foreach (var tech in project.Technologies.Split(',').Take(2))
                                                            {
                                                                <span class="tech-badge small">@tech.Trim()</span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <a asp-page="/Projects" asp-route-experienceId="@experience.Id"
                                       class="btn btn-outline-primary btn-sm mt-2">
                                        View All Projects (@experience.Projects.Count)
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<section class="bg-transparent py-5 border-top border-secondary" style="border-color: var(--glass-border) !important;">
    <div class="container text-center">
        <h2 class="mb-4 text-light">View My Complete Portfolio</h2>
        <p class="lead mb-4 text-secondary">Explore all my projects and detailed work experience</p>
        <a asp-page="/Projects" class="btn btn-outline-primary btn-lg">View Full Portfolio</a>
    </div>
</section>

<style>
    .project-preview-card {
        transition: all 0.2s ease;
    }

    .project-preview-card:hover {
        border-color: var(--accent-primary);
        background-color: rgba(255, 255, 255, 0.05);
    }
</style>