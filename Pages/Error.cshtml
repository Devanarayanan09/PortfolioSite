@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<header class="page-head">
    <div class="container">
        <span class="eyebrow">// error</span>
        <h1 class="page-title">Something went wrong</h1>
        <p class="page-lead">An error occurred while processing your request. Please try again, or go back to the <a asp-page="/Index">home page</a>.</p>
        @if (Model.ShowRequestId)
        {
            <p class="muted small" style="margin-top:16px">Request ID: <code class="mono">@Model.RequestId</code></p>
        }
    </div>
</header>
