@using PortfolioSite.Helpers
@inject IWebHostEnvironment Env
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    string NavClass(string page) => currentPage == page ? "nav-link is-active" : "nav-link";
    string? AriaCurrent(string page) => currentPage == page ? "page" : null;
    var resumeUrl = ContentHelpers.Versioned(Env, "/images/Documents/Resume.pdf");
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(string.IsNullOrEmpty(title) ? "J A Devanarayanan · Senior Backend Developer" : $"{title} · J A Devanarayanan")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "J A Devanarayanan, senior backend developer in Thiruvananthapuram. C#, ASP.NET Core Web API, .NET 8, PostgreSQL and SQL Server.")" />
    <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0f17" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content="J A Devanarayanan · Senior Backend Developer" />
    <meta property="og:description" content="Backend developer building reliable APIs and the databases behind them, with C#, .NET and PostgreSQL." />
    <meta property="og:type" content="website" />
    <link rel="icon" href="~/favicon.ico" />

    <script>
        // Apply the saved theme before first paint to avoid a flash.
        (function () {
            document.documentElement.classList.add('js');
            try {
                var t = localStorage.getItem('theme');
                if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
            } catch (e) { }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" asp-page="/Index" aria-label="J A Devanarayanan, home">
                <span class="brand-mark">JD</span>
                <span class="brand-name">Devanarayanan</span>
            </a>

            <nav class="site-nav" id="site-nav" aria-label="Main">
                <a class="@NavClass("/Index")" aria-current="@AriaCurrent("/Index")" asp-page="/Index">Home</a>
                <a class="@NavClass("/Projects")" aria-current="@AriaCurrent("/Projects")" asp-page="/Projects" asp-route-experienceId="">Work</a>
                <a class="@NavClass("/Documents")" aria-current="@AriaCurrent("/Documents")" asp-page="/Documents">Documents</a>
                <a class="@NavClass("/Contact")" aria-current="@AriaCurrent("/Contact")" asp-page="/Contact">Contact</a>
                <a class="btn btn-primary btn-sm nav-resume" href="@resumeUrl" target="_blank" rel="noopener">@Icon.Get("download", 16) Resume</a>
            </nav>

            <div class="header-actions">
                <button class="icon-btn" type="button" id="theme-toggle" aria-label="Toggle dark mode">
                    <span class="show-light">@Icon.Get("moon")</span>
                    <span class="show-dark">@Icon.Get("sun")</span>
                </button>
                <button class="icon-btn menu-btn" type="button" id="menu-toggle" aria-label="Open menu" aria-controls="site-nav" aria-expanded="false">
                    <span class="menu-open">@Icon.Get("menu")</span>
                    <span class="menu-close">@Icon.Get("close")</span>
                </button>
            </div>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <div>
                <div class="footer-name">J A Devanarayanan</div>
                <div class="muted">Senior Backend Developer · Thiruvananthapuram, India</div>
            </div>
            <div class="footer-links">
                <a href="mailto:devanarayananja98@gmail.com">@Icon.Get("mail", 16) Email</a>
                <a href="https://www.linkedin.com/in/deva-narayanan-9b2114306" target="_blank" rel="noopener">@Icon.Get("linkedin", 16) LinkedIn</a>
                <a href="@resumeUrl" target="_blank" rel="noopener">@Icon.Get("file", 16) Resume</a>
                <a asp-page="/Contact">@Icon.Get("chat", 16) Contact</a>
            </div>
            <div class="muted small">&copy; @DateTime.Now.Year J A Devanarayanan. Built with ASP.NET Core.</div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
