@page
@model DocumentsModel
@using PortfolioSite.Helpers
@{
    ViewData["Title"] = "Documents";
    ViewData["Description"] = "Resume, experience and relieving letters, and award certificates of J A Devanarayanan.";
}

<header class="page-head">
    <div class="container reveal">
        <span class="eyebrow">// documents</span>
        <h1 class="page-title">Documents</h1>
        <p class="page-lead">My resume, employment letters and award certificates, to view or download.</p>
    </div>
</header>

<section class="section">
    <div class="container">
        <div class="doc-grid">
            @foreach (var doc in Model.Documents)
            {
                var url = Model.GetVersionedFilePath(doc.FilePath);
                var type = doc.DocumentType.ToLowerInvariant();
                var icon = type.Contains("award") ? "award" : "file";
                <article class="card doc reveal @(type == "resume" ? "is-featured" : "")">
                    <div class="doc-top">
                        <div class="focus-icon" style="margin:0">@Icon.Get(icon, 20)</div>
                        <span class="doc-type">@doc.DocumentType</span>
                    </div>
                    <h2>@doc.Title</h2>
                    <p>@doc.Description</p>
                    <div class="doc-actions">
                        <a class="btn @(type == "resume" ? "btn-primary" : "btn-secondary") btn-sm" href="@url" target="_blank" rel="noopener">@Icon.Get("eye", 16) View</a>
                        <a class="btn btn-secondary btn-sm btn-icon" href="@url" download aria-label="Download @doc.Title">@Icon.Get("download", 16)</a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>
