@page
@model DocumentsModel
@{
    ViewData["Title"] = "Documents & Credentials";
}

<div class="container py-5 mt-5">
    <div class="text-center mb-5 reveal">
        <h1 class="display-3 fw-bold mb-3">Documents & <span class="text-gradient">Credentials</span></h1>
        <p class="lead text-secondary" style="max-width: 700px; margin: 0 auto;">
            A collection of my professional certifications, awards, and official documents validating my expertise as a backend engineer.
        </p>
    </div>

    <!-- Documents Grid -->
    <div class="row g-4">
        @foreach (var document in Model.Documents)
        {
            <div class="col-lg-4 col-md-6 reveal" style="animation-delay: @(Model.Documents.IndexOf(document) * 0.1)s">
                <div class="glass-card h-100 d-flex flex-column p-4">
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div class="doc-icon-container">
                            @switch (document.DocumentType.ToLower())
                            {
                                case "resume":
                                    <i class="fas fa-file-invoice text-gradient fa-2x"></i>
                                    break;
                                case "certificate":
                                    <i class="fas fa-award text-gradient fa-2x"></i>
                                    break;
                                case "award":
                                    <i class="fas fa-trophy text-gradient fa-2x"></i>
                                    break;
                                case "letter":
                                    <i class="fas fa-file-contract text-gradient fa-2x"></i>
                                    break;
                                default:
                                    <i class="fas fa-file-alt text-gradient fa-2x"></i>
                                    break;
                            }
                        </div>
                        <span class="tech-pill text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em;">@document.DocumentType</span>
                    </div>

                    <div class="flex-grow-1">
                        <h4 class="h5 fw-bold mb-2">@document.Title</h4>
                        <p class="text-secondary small mb-4">@document.Description</p>
                    </div>

                    <div class="d-flex gap-2 mt-auto">
                        <a href="@document.FilePath" target="_blank" class="btn btn-premium flex-grow-1 py-2 fs-6">
                            <i class="fas fa-external-link-alt me-2 small"></i> View
                        </a>
                        <a href="@document.FilePath" download class="btn btn-premium-outline px-3 py-2">
                            <i class="fas fa-download"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .doc-icon-container {
        width: 60px;
        height: 60px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--glass-border);
    }
</style>