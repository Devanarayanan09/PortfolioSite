@page
@model DocumentsModel
@{
    ViewData["Title"] = "Documents & Credentials";
}

<div class="container py-5">
    <!-- Header -->
    <div class="text-center mb-5">
        <h1 class="display-4 mb-3 text-light">Documents & Credentials</h1>
        <p class="lead text-light" style="opacity: 0.75;">My professional documents, certificates, and awards</p>
    </div>

    <!-- Documents Grid -->
    <div class="row">
        @foreach (var document in Model.Documents)
        {
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="glass-card mb-4 h-100 d-flex flex-column bg-transparent border border-secondary shadow-lg">
                    <div class="document-icon">
                        @switch (document.DocumentType.ToLower())
                        {
                            case "resume":
                                <i class="fas fa-file-alt"></i>
                                break;
                            case "certificate":
                                <i class="fas fa-certificate"></i>
                                break;
                            case "award":
                                <i class="fas fa-trophy"></i>
                                break;
                            case "letter":
                                <i class="fas fa-envelope-open-text"></i>
                                break;
                            default:
                                <i class="fas fa-file-pdf"></i>
                                break;
                        }
                    </div>

                    <div class="document-content">
                        <h5 class="document-title">@document.Title</h5>
                        <p class="document-description">@document.Description</p>

                        <div class="document-meta">
                            <span class="document-type">@document.DocumentType</span>
                        </div>
                    </div>

                    <div class="document-actions">
                        <a href="@document.FilePath" target="_blank" class="btn-download">
                            <i class="fas fa-download"></i> Download
                        </a>
                        <a href="@document.FilePath" target="_blank" class="btn-preview">
                            <i class="fas fa-eye"></i> Preview
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .document-icon {
        text-align: center;
        margin-bottom: 1.5rem;
    }

        .document-icon i {
            font-size: 3rem;
            color: var(--accent-primary);
            background: rgba(59, 130, 246, 0.1);
            padding: 1.5rem;
            border-radius: 50%;
        }

    .document-content {
        flex-grow: 1;
        margin-bottom: 1.5rem;
    }

    .document-title {
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
        font-size: 1.2rem;
    }

    .document-description {
        color: var(--text-secondary);
        margin-bottom: 1rem;
        line-height: 1.5;
    }

    .document-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .document-type {
        background: var(--accent-gradient);
        color: white;
        padding: 0.3rem 0.8rem;
        border-radius: 15px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .document-date {
        color: var(--text-secondary);
        font-size: 0.9rem;
    }

    .document-actions {
        display: flex;
        gap: 0.5rem;
    }

    .btn-download, .btn-preview {
        flex: 1;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        text-align: center;
        transition: all 0.3s ease;
    }

    .btn-download {
        background: var(--accent-gradient);
        color: white;
    }

    .btn-preview {
        background: rgba(255, 255, 255, 0.05);
        color: var(--text-primary);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .btn-download:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
    }

    .btn-preview:hover {
        background: #e9ecef;
    }
</style>