@page
@model ContactModel
@using PortfolioSite.Helpers
@{
    ViewData["Title"] = "Contact";
    ViewData["Description"] = "Contact J A Devanarayanan, senior backend developer (.NET, PostgreSQL, SQL Server) in Thiruvananthapuram, India.";
}

<header class="page-head">
    <div class="container reveal">
        <span class="eyebrow">// contact</span>
        <h1 class="page-title">Get in touch</h1>
        <p class="page-lead">For backend roles, interviews or questions about my work, email is the quickest way to reach me.</p>
    </div>
</header>

<section class="section">
    <div class="container">
        <div class="contact-grid">
            <a class="card contact-card reveal" href="mailto:devanarayananja98@gmail.com">
                <div class="focus-icon">@Icon.Get("mail", 20)</div>
                <span class="label">Email</span>
                <span class="value">devanarayananja98@gmail.com</span>
            </a>
            <a class="card contact-card reveal" href="tel:+919447270493">
                <div class="focus-icon">@Icon.Get("phone", 20)</div>
                <span class="label">Phone / WhatsApp</span>
                <span class="value">+91 94472 70493</span>
            </a>
            <a class="card contact-card reveal" href="https://www.linkedin.com/in/deva-narayanan-9b2114306" target="_blank" rel="noopener">
                <div class="focus-icon">@Icon.Get("linkedin", 20)</div>
                <span class="label">LinkedIn</span>
                <span class="value">linkedin.com/in/deva-narayanan-9b2114306</span>
            </a>
            <div class="card contact-card reveal">
                <div class="focus-icon">@Icon.Get("map-pin", 20)</div>
                <span class="label">Location</span>
                <span class="value">Thiruvananthapuram, Kerala, India</span>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="cta reveal">
            <div>
                <h2>Want the full picture first?</h2>
                <p>My resume covers my experience at Cocopalms and Infosys, the projects and my technical skills.</p>
            </div>
            <div class="cta-actions">
                <a class="btn btn-primary" asp-page="/Documents">@Icon.Get("file") Resume &amp; documents</a>
                <a class="btn btn-ghost" asp-page="/Projects" asp-route-experienceId="">See projects</a>
            </div>
        </div>
    </div>
</section>
