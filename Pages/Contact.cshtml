@page
@model ContactModel
@{
    ViewData["Title"] = "Contact Me";
}

<div class="container py-5 mt-5">
    <div class="text-center mb-5 reveal">
        <h1 class="display-3 fw-bold mb-3">Get in <span class="text-gradient">Touch</span></h1>
        <p class="lead text-secondary" style="max-width: 700px; margin: 0 auto;">
            I'm always open to discussing new projects, backend architecture, or potential opportunities in the .NET ecosystem.
        </p>
    </div>

    <div class="row justify-content-center reveal" style="animation-delay: 0.1s">
        <div class="col-lg-8">
            <div class="glass-card p-4 p-md-5">
                <div class="row g-4 mb-5">
                    <!-- Email -->
                    <div class="col-md-6">
                        <div class="contact-method p-4 h-100">
                            <div class="contact-icon mb-3">
                                <i class="fas fa-envelope fa-2x text-gradient"></i>
                            </div>
                            <h4 class="h5 fw-bold mb-2">Email Me</h4>
                            <p class="text-muted small mb-3">Direct response within 24 hours</p>
                            <a href="mailto:devanarayananja98@gmail.com" class="text-white fw-bold text-decoration-none border-bottom border-cyan pb-1">
                                devanarayananja98@gmail.com
                            </a>
                        </div>
                    </div>

                    <!-- Call -->
                    <div class="col-md-6">
                        <div class="contact-method p-4 h-100">
                            <div class="contact-icon mb-3">
                                <i class="fas fa-phone-alt fa-2x text-gradient"></i>
                            </div>
                            <h4 class="h5 fw-bold mb-2">Call Me</h4>
                            <p class="text-muted small mb-3">Available for urgent discussions</p>
                            <a href="tel:+919447270493" class="text-white fw-bold text-decoration-none border-bottom border-cyan pb-1">
                                +91 9447270493
                            </a>
                        </div>
                    </div>

                    <!-- Location -->
                    <div class="col-12">
                        <div class="contact-method p-4 d-flex align-items-center gap-4">
                            <div class="contact-icon">
                                <i class="fas fa-map-marker-alt fa-2x text-gradient"></i>
                            </div>
                            <div>
                                <h4 class="h5 fw-bold mb-1">Location</h4>
                                <p class="text-muted mb-0">Trivandrum, Kerala, India — Working Globally</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer Call to Action -->
                <div class="text-center border-top border-secondary pt-5 mt-2" style="border-color: var(--glass-border) !important;">
                    <h3 class="h4 fw-bold mb-4">Alternatively, connect with me on social platforms</h3>
                    <div class="d-flex justify-content-center gap-4">
                        <a href="#" class="social-link"><i class="fab fa-linkedin fa-2x"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-github fa-2x"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-twitter fa-2x"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .contact-method {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--glass-border);
        border-radius: 20px;
        transition: all 0.3s ease;
    }

    .contact-method:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(99, 102, 241, 0.3);
        transform: translateY(-5px);
    }

    .contact-icon {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 15px;
    }

    .social-link {
        color: var(--text-secondary);
        transition: all 0.3s ease;
    }

    .social-link:hover {
        color: var(--accent-cyan);
        transform: translateY(-3px);
    }

    .border-cyan {
        border-color: var(--accent-cyan) !important;
    }
</style>