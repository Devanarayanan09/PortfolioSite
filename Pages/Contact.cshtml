@page
@model ContactModel
@{
    ViewData["Title"] = "Contact";
}

<div class="container py-5">
    <!-- Stylish Header -->
    <div class="text-center mb-5">
        <h1 class="contact-main-title">Get In Touch</h1>
        <p class="contact-subtitle">Let's connect and create something amazing</p>
        <div class="header-divider">
            <div class="divider-line"></div>
            <i class="fas fa-star divider-icon"></i>
            <div class="divider-line"></div>
        </div>
    </div>

    <!-- Contact Information Card -->
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="contact-card">
                <div class="contact-card-header">
                    <i class="fas fa-paper-plane contact-card-icon"></i>
                    <h2 class="contact-card-title">Contact Information</h2>
                </div>

                <div class="contact-content">
                    <!-- Email -->
                    <div class="contact-item-wrapper">
                        <div class="contact-item">
                            <div class="contact-icon-circle">
                                <i class="fas fa-envelope"></i>
                            </div>
                            <div class="contact-text">
                                <h4 class="contact-label">Email</h4>
                                <a href="mailto:devanarayananja98@gmail.com" class="contact-value">
                                    devanarayananja98@gmail.com
                                </a>
                            </div>
                            <div class="contact-action">
                                <a href="mailto:devanarayananja98@gmail.com" class="action-btn">
                                    <i class="fas fa-paper-plane"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Mobile -->
                    <div class="contact-item-wrapper">
                        <div class="contact-item">
                            <div class="contact-icon-circle">
                                <i class="fas fa-phone"></i>
                            </div>
                            <div class="contact-text">
                                <h4 class="contact-label">Mobile</h4>
                                <a href="tel:+919447270493" class="contact-value">
                                    +91 9447270493
                                </a>
                            </div>
                            <div class="contact-action">
                                <a href="tel:+919447270493" class="action-btn">
                                    <i class="fas fa-phone"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Location -->
                    <div class="contact-item-wrapper">
                        <div class="contact-item">
                            <div class="contact-icon-circle">
                                <i class="fas fa-map-marker-alt"></i>
                            </div>
                            <div class="contact-text">
                                <h4 class="contact-label">Location</h4>
                                <span class="contact-value">Trivandrum, India</span>
                            </div>
                            <div class="contact-action">
                                <a href="https://maps.google.com/?q=Trivandrum,India" target="_blank" class="action-btn">
                                    <i class="fas fa-map"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Action Buttons -->
                <div class="contact-actions">
                    <a href="mailto:devanarayananja98@gmail.com" class="quick-action-btn primary">
                        <i class="fas fa-envelope me-2"></i>Send Email
                    </a>
                    <a href="tel:+919447270493" class="quick-action-btn secondary">
                        <i class="fas fa-phone me-2"></i>Call Now
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Main Title */
    .contact-main-title {
        font-size: 3.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.5rem;
        letter-spacing: -1px;
    }

    .contact-subtitle {
        font-size: 1.3rem;
        color: #6c757d;
        font-weight: 300;
        margin-bottom: 2rem;
    }

    .header-divider {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        max-width: 200px;
        margin: 0 auto;
    }

    .divider-line {
        flex: 1;
        height: 2px;
        background: linear-gradient(90deg, transparent, #667eea, transparent);
    }

    .divider-icon {
        color: #667eea;
        font-size: 1rem;
    }

    /* Contact Card */
    .contact-card {
        background: linear-gradient(135deg, #ffffff 0%, #f8f9ff 100%);
        border-radius: 20px;
        padding: 3rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(102, 126, 234, 0.1);
        backdrop-filter: blur(10px);
    }

    .contact-card-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .contact-card-icon {
        font-size: 3rem;
        color: #667eea;
        margin-bottom: 1rem;
    }

    .contact-card-title {
        font-size: 2rem;
        font-weight: 700;
        color: #2c3e50;
        margin: 0;
    }

    /* Contact Items */
    .contact-item-wrapper {
        margin-bottom: 2rem;
        position: relative;
    }

        .contact-item-wrapper::after {
            content: '';
            position: absolute;
            bottom: -1rem;
            left: 50%;
            transform: translateX(-50%);
            width: 80%;
            height: 1px;
            background: linear-gradient(90deg, transparent, #e9ecef, transparent);
        }

        .contact-item-wrapper:last-child::after {
            display: none;
        }

    .contact-item {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 1.5rem;
        border-radius: 15px;
        transition: all 0.3s ease;
        background: rgba(255, 255, 255, 0.8);
    }

        .contact-item:hover {
            background: rgba(102, 126, 234, 0.05);
            transform: translateX(5px);
        }

    .contact-icon-circle {
        width: 60px;
        height: 60px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .contact-text {
        flex-grow: 1;
    }

    .contact-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: #6c757d;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .contact-value {
        font-size: 1.2rem;
        font-weight: 600;
        color: #2c3e50;
        text-decoration: none;
        transition: color 0.3s ease;
    }

        .contact-value:hover {
            color: #667eea;
        }

    .contact-action .action-btn {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-decoration: none;
        transition: all 0.3s ease;
        opacity: 0;
        transform: scale(0.8);
    }

    .contact-item:hover .action-btn {
        opacity: 1;
        transform: scale(1);
    }

    .action-btn:hover {
        transform: scale(1.1) !important;
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
    }

    /* Quick Action Buttons */
    .contact-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(102, 126, 234, 0.1);
    }

    .quick-action-btn {
        padding: 1rem 2rem;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
    }

        .quick-action-btn.primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
        }

        .quick-action-btn.secondary {
            background: transparent;
            color: #667eea;
            border: 2px solid #667eea;
        }

        .quick-action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
        }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .contact-main-title {
            font-size: 2.5rem;
        }

        .contact-subtitle {
            font-size: 1.1rem;
        }

        .contact-card {
            padding: 2rem;
            margin: 0 1rem;
        }

        .contact-item {
            flex-direction: column;
            text-align: center;
            gap: 1rem;
        }

        .contact-actions {
            flex-direction: column;
        }

        .quick-action-btn {
            justify-content: center;
        }

        .contact-action .action-btn {
            opacity: 1;
            transform: scale(1);
        }
    }
</style>