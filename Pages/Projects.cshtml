@page "{experienceId:int?}"
@model ProjectsModel
@using PortfolioSite.Helpers
@{
    ViewData["Title"] = "Work";
    ViewData["Description"] = "Projects by J A Devanarayanan: Bizo Suite, GLOMO, IVISA and Jananthikam. What was built, and with which stack.";
}

<header class="page-head">
    <div class="container reveal">
        <span class="eyebrow">// work</span>
        <h1 class="page-title">Projects</h1>
        <p class="page-lead">What I built on each project, and the stack it runs on. Bizo Suite is my current work; GLOMO and IVISA are internal Infosys applications.</p>
    </div>
</header>

<section class="section">
    <div class="container">
        <nav class="filters reveal" aria-label="Filter by employer">
            <a class="chip @(Model.SelectedExperienceId == null ? "is-active" : "")" asp-page="/Projects" asp-route-experienceId=""
               aria-current="@(Model.SelectedExperienceId == null ? "page" : null)">All</a>
            @foreach (var exp in Model.Experiences)
            {
                <a class="chip @(Model.SelectedExperienceId == exp.Id ? "is-active" : "")" asp-page="/Projects" asp-route-experienceId="@exp.Id"
                   aria-current="@(Model.SelectedExperienceId == exp.Id ? "page" : null)">@exp.Company</a>
            }
        </nav>

        <div class="project-list">
            @foreach (var project in Model.Projects)
            {
                var bullets = ContentHelpers.ToBullets(project.Description);
                <article class="card project-detail reveal" id="project-@project.Id">
                    <div>
                        <div class="project-meta">@project.Experience?.Company</div>
                        <h2>@project.Title</h2>
                        @if (!string.IsNullOrEmpty(project.Summary))
                        {
                            <p class="summary">@project.Summary</p>
                        }
                        @if (bullets.Count > 1)
                        {
                            <ul class="bullets">
                                @foreach (var b in bullets)
                                {
                                    <li>@b</li>
                                }
                            </ul>
                        }
                        else if (bullets.Count == 1)
                        {
                            <p class="summary">@bullets[0]</p>
                        }
                    </div>

                    <aside class="project-aside">
                        @if (project.Experience is not null)
                        {
                            <div>
                                <div class="aside-label">Role</div>
                                <div class="aside-value">@project.Experience.Position</div>
                                <div class="muted small">@project.Experience.Period()</div>
                            </div>
                        }
                        <div>
                            <div class="aside-label">Stack</div>
                            <ul class="tags">
                                @foreach (var tech in ContentHelpers.SplitTags(project.Technologies))
                                {
                                    <li class="tag">@tech</li>
                                }
                            </ul>
                        </div>
                        @if (!string.IsNullOrEmpty(project.ProjectUrl))
                        {
                            <div>
                                <div class="aside-label">Live</div>
                                <a class="ext-link" href="@project.ProjectUrl" target="_blank" rel="noopener">
                                    @ContentHelpers.LinkLabel(project.ProjectUrl) @Icon.Get("arrow-up-right", 15)
                                </a>
                            </div>
                        }
                    </aside>
                </article>
            }

            @if (!Model.Projects.Any())
            {
                <p class="muted">No projects listed for this filter yet.</p>
            }
        </div>
    </div>
</section>
