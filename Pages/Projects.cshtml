@page "{experienceId:int?}"
@model ProjectsModel
@{
    ViewData["Title"] = "Projects Portfolio";
}

<div class="container py-5 mt-5">
    <div class="text-center mb-5 reveal">
        <h1 class="display-3 fw-bold mb-3">Projects <span class="text-gradient">Portfolio</span></h1>
        <p class="lead text-secondary" style="max-width: 700px; margin: 0 auto;">
            A showcase of technical challenges I've solved and systems I've built throughout my career.
        </p>
    </div>

    <!-- Experience Filter - Premium Style -->
    <div class="row mb-5 reveal" style="animation-delay: 0.1s">
        <div class="col-lg-10 mx-auto">
            <div class="glass-card p-4">
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-page="/Projects"
                       class="btn @(Model.SelectedExperienceId == null ? "btn-premium" : "btn-premium-outline") d-flex align-items-center gap-2">
                        <i class="fas fa-layer-group"></i>
                        <span>All Work</span>
                        <span class="badge rounded-pill bg-white bg-opacity-10 ms-1">@Model.Projects.Count</span>
                    </a>

                    @foreach (var exp in Model.Experiences)
                    {
                        var projectCount = Model.Projects.Count(p => p.ExperienceId == exp.Id);
                        <a asp-page="/Projects" asp-route-experienceId="@exp.Id"
                           class="btn @(Model.SelectedExperienceId == exp.Id ? "btn-premium" : "btn-premium-outline") d-flex align-items-center gap-2">
                            <i class="fas fa-building small"></i>
                            <span>@exp.Company</span>
                            <span class="badge rounded-pill bg-white bg-opacity-10 ms-1">@projectCount</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Projects Grid -->
    <div class="row g-4 reveal" style="animation-delay: 0.2s">
        @foreach (var project in Model.Projects)
        {
            <div id="project-@project.Id" class="col-lg-6">
                <div class="glass-card h-100 p-0 overflow-hidden">
                    <div class="position-relative">
                        <img src="@project.ImageUrl" class="card-img-top" alt="@project.Title" style="height: 240px; object-fit: cover; opacity: 0.8;">
                        <div class="position-absolute bottom-0 start-0 w-100 p-3" style="background: linear-gradient(transparent, var(--bg-surface));">
                            <h3 class="h4 fw-bold mb-0 text-white">@project.Title</h3>
                        </div>
                    </div>
                    
                    <div class="p-4">
                        @if (project.Experience != null)
                        {
                            <div class="mb-3">
                                <span class="exp-date small">@project.Experience.Company</span>
                                <span class="text-muted mx-2">|</span>
                                <span class="text-secondary small">@project.Experience.Position</span>
                            </div>
                        }

                        <p class="text-secondary mb-4">@Html.Raw(project.Description)</p>

                        <div class="mb-4">
                            @foreach (var tech in project.Technologies.Split(','))
                            {
                                <span class="tech-pill">@tech.Trim()</span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(project.ProjectUrl))
                        {
                            <a href="@project.ProjectUrl" target="_blank" class="btn btn-premium w-100">
                                <i class="fas fa-external-link-alt me-2 small"></i> View Implementation
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Projects.Any())
    {
        <div class="text-center py-5 glass-card mt-4 reveal">
            <i class="fas fa-search fa-3x text-muted mb-3"></i>
            <h4>No projects found</h4>
            <p class="text-muted">Select a different filter to explore other projects.</p>
        </div>
    }
</div>