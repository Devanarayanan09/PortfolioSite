@page "{experienceId:int?}"
@model ProjectsModel
@{
    ViewData["Title"] = "Selected Work";
}

<div class="bg-accent pt-5">
    <div class="container pt-5 pb-5 mt-5 reveal">
        <h1 class="display-3 fw-black mb-3">Selected <span class="text-primary">Projects</span></h1>
        <p class="lead text-muted" style="max-width: 600px;">
            A deep dive into the architectures, technical hurdles, and solutions I've engineered.
        </p>
    </div>
</div>

<div class="container py-5">
    <!-- Filter -->
    <div class="d-flex flex-wrap gap-2 mb-5 reveal">
        <a asp-page="/Projects" asp-route-experienceId="" class="btn-alt @(Model.SelectedExperienceId == null ? "bg-primary text-white border-primary" : "") px-4 py-2">
            All Systems
        </a>
        @foreach (var exp in Model.Experiences)
        {
            <a asp-page="/Projects" asp-route-experienceId="@exp.Id" 
               class="btn-alt @(Model.SelectedExperienceId == exp.Id ? "bg-primary text-white border-primary" : "") px-4 py-2">
                @exp.Company
            </a>
        }
    </div>

    <div class="row g-4 reveal">
        @foreach (var project in Model.Projects)
        {
            <div class="col-lg-6" id="project-@project.Id">
                <div class="card-neo h-100 d-flex flex-column border-0" style="background: #fff; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);">
                    <div class="mb-4 d-flex justify-content-between align-items-center">
                        <div class="p-3 rounded-4 bg-light text-primary">
                            <i class="fas fa-project-diagram fa-2x"></i>
                        </div>
                        @if (!string.IsNullOrEmpty(project.ProjectUrl))
                        {
                            <a href="@project.ProjectUrl" target="_blank" class="text-muted"><i class="fas fa-external-link-alt fa-lg"></i></a>
                        }
                    </div>
                    
                    <h3 class="h4 mb-2">@project.Title</h3>
                    <div class="small fw-bold text-primary mb-3 text-uppercase">@project.Experience?.Company</div>
                    
                    <div class="flex-grow-1 text-muted mb-4">
                        @Html.Raw(project.Description)
                    </div>

                    <div class="mt-auto pt-4 border-top border-light">
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var tech in project.Technologies.Split(','))
                            {
                                <span class="tag-pill m-0">@tech.Trim()</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .fw-black { font-weight: 900; }
    .bg-accent { background-color: var(--bg-accent); }
</style>